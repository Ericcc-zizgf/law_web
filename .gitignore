.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 本機秘密設定；公開儲存庫不得包含任何 .env 內容
.env
.env.*
*.pem
*.key

# 本機部署工具狀態
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# 案件、卷證、解析結果與向量資料只能放在本機或 EFS
uploads/
case_uploads/
data/

# 本機封存、Notebook 與部署壓縮包
archive/
notebooks/
dist/
